# Configuration d'environnement HRMS : copier vers un fichier hors dépôt (*.env est ignoré par git).
# Ne jamais renseigner de mot de passe ou de secret dans ce fichier versionné.

HRMS_DB_CONNECT=
HRMS_SCHEMA=HRMS
APEX_WORKSPACE=
APEX_APP_ID=
ORDS_BASE_URL=

# SSO : exactement un protocole par environnement (OIDC ou SAML)
SSO_PROTOCOL=OIDC
SSO_ISSUER_URL=
SSO_CLIENT_ID=
# Le secret client et les certificats sont fournis par le gestionnaire de secrets de l'environnement
